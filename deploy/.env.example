# Скопируйте: cp .env.example .env && nano .env

# Образ приложения (GitHub Actions → GHCR)
DOCKER_IMAGE=ghcr.io/iiika8/vr-backend.service:latest

# Сессии Express (длинная случайная строка)
SESS_SECRET=замените_на_случайную_строку

# MongoDB: один и тот же логин/пароль для контейнера mongo (root) и для приложения.
# В Compass / mongosh: пользователь = MONGO_USER, пароль = MONGO_PASSWORD, Authentication DB = admin
MONGO_USER=
MONGO_PASSWORD=

PORT=8080
NODE_ENV=production
TRUST_PROXY=1

# Опционально
# MONGODB_URI=mongodb://user:pass@mongodb:27017/vr-app?authSource=admin
# MONGODB_URI переопределяет сборку URI из MONGO_* (удобно, если в пароле экзотика и проще вставить готовую строку)
