# Копируйте в .env и задайте свои значения.
# Для Docker: переменные можно задать в .env рядом с docker-compose.yml
# либо передавать при запуске: docker compose --env-file .env up -d

# Порт приложения на хосте (в контейнере всегда 8080)
PORT=8080

# Секрет для сессий (обязательно смените в продакшене)
SESS_SECRET=your-secret-at-least-32-chars-long

# Окружение: development | production
NODE_ENV=production

# Подключение к MongoDB (для локального запуска без Docker)
# В Docker Compose используется внутренний URI: mongodb://mongodb:27017/vr-app
# MONGODB_URI=mongodb://localhost:27017/vr-app

# Порт MongoDB на хосте (для доступа с ПК: Compass, Studio 3T). По умолчанию 27017.
# MONGODB_PORT=27017

# Опционально: IP для бинда (в контейнере лучше 0.0.0.0)
# SERVER_IP=0.0.0.0

# За reverse proxy (Nginx/Traefik): 1 — чтобы req.ip и host были с реального клиента
# TRUST_PROXY=1
