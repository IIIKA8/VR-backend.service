# Скопируйте: cp .env.example .env && nano .env

# Образ приложения (GitHub Actions → GHCR)
DOCKER_IMAGE=ghcr.io/iiika8/vr-backend.service:latest

# Сессии Express
SESS_SECRET=замените_на_случайную_строку

PORT=8080
NODE_ENV=production
TRUST_PROXY=1

# По умолчанию приложение и Compass подключаются к Mongo без логина (внутри Docker).
# Переопределить строку подключения (например с паролем):
# MONGODB_URI=mongodb://user:pass@mongodb:27017/vr-app?authSource=admin
