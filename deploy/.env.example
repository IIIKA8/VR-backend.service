# Скопируйте в .env и заполните.
# Обязательно: DOCKER_IMAGE и SESS_SECRET.

# Образ приложения (Docker Hub: логин/репозиторий:тег)
DOCKER_IMAGE=leshien/vr-backend-web-app:latest

# Секрет для сессий (обязательно смените)
SESS_SECRET=your-secret-at-least-32-chars

# Порт на хосте (опционально)
PORT=8080

# За прокси (опционально)
# TRUST_PROXY=1
