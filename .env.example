# Скопируйте файл в .env и задайте свои значения.
PORT=8080

SESS_SECRET=your-secret-at-least-32-chars-long

# Пароль для опасных операций purge лицензий в админке (не храните в репозитории)
LICENSE_PURGE_PASSWORD=change-this-purge-password

MONGO_USER=admin
MONGO_PASSWORD=change-this-password

NODE_ENV=production

MONGO_HOST=localhost
MONGO_DB=vr-app
# MONGODB_PORT=27017
# MONGODB_URI=mongodb://admin:change-this-password@localhost:27017/vr-app?authSource=admin
# SERVER_IP=0.0.0.0
# TRUST_PROXY=1
