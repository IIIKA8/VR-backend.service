# Скопируйте: cp .env.example .env && nano .env

# Образ приложения (GitHub Actions → GHCR)
DOCKER_IMAGE=ghcr.io/iiika8/vr-backend.service:latest

# Сессии Express
SESS_SECRET=замените_на_случайную_строку

PORT=8080
NODE_ENV=production
TRUST_PROXY=1

# MongoDB (обязательно). Инициализация пользователя только при первом создании тома mongodb_data.
MONGO_USER=admin
MONGO_PASSWORD=сгенерируйте_длинный_случайный_пароль

# Compass с ПК: SSH на сервер, затем подключение к 127.0.0.1:27017 (порт слушает только localhost).
# Не открывайте 27017 на 0.0.0.0 — иначе снова сканеры/ransomware.
