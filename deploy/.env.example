# Скопируйте в .env на сервере: cp .env.example .env && nano .env

# Образ из GitHub Actions (GHCR). Точное имя — в логе job «Publish Docker image»
# или на github.com → Packages → ваш пакет docker.
# Формат: ghcr.io/<владелец-нижний-регистр>/<репо-нижний-регистр>:latest
DOCKER_IMAGE=ghcr.io/iiika8/vr-backend.service:latest

# Обязательно: случайная длинная строка для сессий (не коммитьте в git)
SESS_SECRET=замените_на_случайную_строку_минимум_32_символа

# Порт HTTP снаружи (по умолчанию 8080)
PORT=8080

# Опционально: порт MongoDB на хосте (обычно только localhost)
# MONGODB_PORT=27017

# За прокси / HTTPS — оставьте 1
TRUST_PROXY=1
