# Копируйте в .env и задайте свои значения.
# Для Docker: переменные можно задать в .env рядом с docker-compose.yml
# либо передавать при запуске: docker compose --env-file .env up -d

# Порт приложения на хосте (в контейнере всегда 8080)
PORT=8080

# Секрет для сессий (обязательно смените в продакшене)
SESS_SECRET=your-secret-at-least-32-chars-long

# MongoDB: обязательные учётные данные (инициализация только при первом создании тома mongodb_data)
MONGO_USER=admin
MONGO_PASSWORD=сгенерируйте-длинный-случайный-пароль

# Окружение: development | production
NODE_ENV=production

# Подключение к MongoDB (переопределите при необходимости; по умолчанию собирается из MONGO_USER/MONGO_PASSWORD)
# Локально без Docker:
# MONGODB_URI=mongodb://admin:ПАРОЛЬ@localhost:27017/vr-app?authSource=admin

# Порт MongoDB на хосте только на 127.0.0.1 (Compass с ПК — через SSH-туннель). По умолчанию 27017.
# MONGODB_PORT=27017

# Опционально: IP для бинда (в контейнере лучше 0.0.0.0)
# SERVER_IP=0.0.0.0

# За reverse proxy (Nginx/Traefik): 1 — чтобы req.ip и host были с реального клиента
# TRUST_PROXY=1
